<!doctype html>
<!--
  Quarterdeck cloud artifact template, version 1.
  `quarterdeck export --artifact FILE` fills the title and snapshot
  placeholders below and writes the page outside any repository. Publish the
  result as a private Claude artifact with capabilities
  {db: {}, downloads: true, comments: {composer_only: true}}.
  Report clicks are stored in the artifact's own shared database (collection
  "qd-actions") and applied back with `quarterdeck import`. Reactions and
  replies are stored in collection "qd-inbox" and delivered to Firstmate with
  `quarterdeck reactions import`.
  See docs/how-to/use-the-cloud-artifact.md.
-->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>__QUARTERDECK_TITLE__</title>
<style>
:root {
  --bg: #f4f1ea; --surface: #fffdf8; --fg: #20303d; --muted: #657482; --line: #d8d3c8;
  --accent: #176b69; --accent-soft: #e6f1ee; --head: #17324d; --gold: #c98635; --warn: #624313; --warn-soft: #fff8e9;
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark) { :root {
  --bg: #11181f; --surface: #1a242d; --fg: #e3e8ec; --muted: #9aa8b3; --line: #33434f;
  --accent: #5fc2b9; --accent-soft: #1f3a37; --head: #0d2438; --gold: #e0a24e; --warn: #f0d9a8; --warn-soft: #2d2412;
} }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
header { background: var(--head); color: #fffdf8; padding: .55rem max(1rem, calc((100vw - 60rem) / 2)); border-bottom: 3px solid var(--gold); display: flex; flex-wrap: wrap; gap: .1rem 1rem; align-items: baseline; }
h1 { margin: 0; font: 700 1.1rem/1.3 Georgia, serif; }
header p { margin: 0; font-size: .82rem; color: #e4e8e8; }
main { width: min(60rem, calc(100% - 2rem)); margin: 1.2rem auto 4rem; }
h2 { margin: 0; font: 700 1.25rem/1.3 Georgia, serif; }
section, details.group { margin: 1.4rem 0; }
.head { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
.head p, .note { margin: .2rem 0 .6rem; color: var(--muted); font-size: .9rem; }
.count { border: 1px solid var(--line); background: var(--surface); border-radius: 999px; min-width: 2rem; padding: .1rem .6rem; text-align: center; font-weight: 700; color: var(--accent); }
details.group > summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; list-style: none; }
details.group > summary::-webkit-details-marker { display: none; }
details.group > summary h2::before { content: "▸ "; color: var(--gold); }
details.group[open] > summary h2::before { content: "▾ "; }
.card { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 10px; padding: .8rem 1rem; margin: .6rem 0; }
.card h3 { margin: 0 0 .2rem; font: 700 1.05rem/1.3 Georgia, serif; overflow-wrap: anywhere; }
.card p { margin: .3rem 0; overflow-wrap: anywhere; }
.chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .4rem; }
.chip { border: 1px solid var(--line); border-radius: 999px; padding: .05rem .55rem; font-size: .78rem; color: var(--muted); }
.chip.group { color: var(--accent); border-color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
.chip.warn { color: var(--warn); background: var(--warn-soft); border-color: var(--gold); }
.chip.rec { color: var(--fg); background: var(--accent-soft); border-color: var(--accent); }
.actions { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-top: .6rem; }
button { font: inherit; font-size: .88rem; font-weight: 700; min-height: 44px; padding: 0 .9rem; border: 1px solid var(--accent); border-radius: 8px; background: var(--accent-soft); color: var(--fg); cursor: pointer; }
button:disabled { opacity: .6; cursor: default; }
button:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
a { color: var(--accent); font-weight: 650; }
.empty { border: 1px dashed var(--line); border-radius: 10px; color: var(--muted); padding: .8rem 1rem; }
.sub { margin: 1rem 0 .3rem; font-size: .95rem; color: var(--accent); }
.status { color: var(--muted); font-size: .85rem; }
footer { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 1rem; color: var(--muted); font-size: .85rem; }
.reaction { margin-top: .6rem; }
.reaction .latest { margin: .3rem 0; color: var(--muted); font-size: .85rem; }
.reaction .choices { display: flex; flex-wrap: wrap; gap: .4rem; }
.reaction button[aria-pressed="true"] { background: var(--accent); color: var(--surface); }
.reaction .reply { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-top: .5rem; }
.reaction input[type="text"] { flex: 1 1 14rem; min-width: 0; min-height: 44px; padding: 0 .6rem; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--fg); font: inherit; font-size: .9rem; }
.report-body { white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
.card details { margin: .5rem 0; }
.card details > summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-weight: 650; color: var(--accent); }
.card details > .report-body { margin: .2rem 0 .4rem; }
.access { color: var(--warn); }
.error { border: 1px solid var(--gold); background: var(--warn-soft); color: var(--warn); border-radius: 10px; padding: .6rem 1rem; margin: .6rem 0; overflow-wrap: anywhere; }
</style>
</head>
<body>
<header>
  <h1 id="title">⚓ Quarterdeck</h1>
  <p id="generated"></p>
  <p id="sync" class="status"></p>
</header>
<main id="root"></main>
<script type="application/json" id="qd-snapshot">__QUARTERDECK_SNAPSHOT__</script>
<script>
(function () {
  "use strict";
  var snapshot = JSON.parse(document.getElementById("qd-snapshot").textContent);
  var COLLECTION = "qd-actions";
  var INBOX = "qd-inbox";
  var REACTIONS = [["approve", "Approve"], ["hold", "Hold"], ["not-now", "Not now"], ["question", "Question"]];
  var TEXT_LIMIT = 1000;
  var actionDocs = {};   // report id -> latest recorded action document
  var inboxDocs = {};    // reaction id -> recorded reaction document
  var drafts = {};       // "kind:item id" -> {reaction, text, id, sending, status} typed but not sent
  var db = null;
  var comments = null;
  // Each capability is "pending" until claude.use() settles, then "ready" or "unavailable" (with a reason).
  var access = {
    db: { state: "pending", reason: "" },
    comments: { state: "pending", reason: "" },
  };
  var syncErrors = {};   // collection name or "downloads" -> an error to show in the header
  var renderErrors = []; // card-level render failures from the latest render
  var renderFailure = ""; // a render failure that stopped the page
  var pendingOpen = null;
  var composers = {};    // "kind:item id" -> every rendered {choices, input, status} for that draft

  function el(tag, attrs, children) {
    var node = document.createElement(tag);
    Object.keys(attrs || {}).forEach(function (key) {
      if (key === "text") node.textContent = attrs[key];
      else if (key === "class") node.className = attrs[key];
      else node.setAttribute(key, attrs[key]);
    });
    (children || []).forEach(function (child) { if (child) node.appendChild(child); });
    return node;
  }
  function chip(text, kind) { return el("span", { "class": "chip" + (kind ? " " + kind : ""), text: text }); }
  function safeUrl(value) {
    try { var url = new URL(value); return url.protocol === "https:" || url.protocol === "http:" ? url.href : null; }
    catch (_) { return null; }
  }
  function ago(iso) {
    if (!iso) return "";
    var minutes = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60000));
    if (minutes < 60) return minutes + " min ago";
    if (minutes < 2880) return Math.round(minutes / 60) + " h ago";
    return Math.round(minutes / 1440) + " days ago";
  }
  function docId(reportId) { return encodeURIComponent(reportId).replace(/%/g, "_"); }

  function reactionLabel(name) {
    var found = REACTIONS.filter(function (pair) { return pair[0] === name; })[0];
    return found ? found[1] : "";
  }
  function newReactionId() {
    var raw = window.crypto && crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2);
    return raw.replace(/[^A-Za-z0-9._-]/g, "").slice(0, 64);
  }
  // The newest reaction for an item, from the snapshot (sent from the local page) or this artifact's inbox.
  function latestReaction(kind, id) {
    var best = null;
    (snapshot.reactions || []).concat(Object.keys(inboxDocs).map(function (key) { return inboxDocs[key]; })).forEach(function (r) {
      if (r.kind === kind && r.item_id === id && r.at && (!best || Date.parse(r.at) >= Date.parse(best.at))) best = r;
    });
    return best;
  }
  function latestText(r) {
    if (!r) return "";
    var label = reactionLabel(r.reaction);
    var summary = label && r.text ? label + ": " + r.text : label || r.text;
    return "Latest reaction: " + summary + " (" + (r.source === "artifact" ? "from the artifact" : "from the local page") + ", " + ago(r.at) + ")";
  }
  function pendingReactions() {
    var delivered = {};
    (snapshot.delivered || []).forEach(function (id) { delivered[id] = true; });
    return Object.keys(inboxDocs).filter(function (id) { return !delivered[id]; })
      .map(function (id) { return inboxDocs[id]; })
      .sort(function (a, b) { return Date.parse(a.at) - Date.parse(b.at); });
  }

  // A short per-card hint; the header carries the full reason.
  function accessHint() {
    var off = [];
    if (!db) off.push("Reactions");
    if (!comments) off.push("Discuss");
    if (!off.length) return "";
    if ((!db && access.db.state === "pending") || (!comments && access.comments.state === "pending")) return "Connecting…";
    return off.join(" and ") + " unavailable, see the note at the top.";
  }
  // The one-line header text: what is connected, what is not, and why.
  function statusLine() {
    var parts = [];
    if (renderFailure) parts.push("Render error: " + renderFailure);
    else if (renderErrors.length) parts.push("Render error in " + renderErrors.length + " card" + (renderErrors.length === 1 ? "" : "s") + ": " + renderErrors[0]);
    if (access.db.state === "pending" || access.comments.state === "pending") {
      parts.push("Connecting to the artifact database and comments…");
    } else {
      if (db) parts.push("Connected: reactions and review actions are saved in this artifact.");
      else parts.push("Read-only: " + access.db.reason);
      if (!comments) parts.push("Discuss with Firstmate is off: " + access.comments.reason);
    }
    Object.keys(syncErrors).forEach(function (key) { parts.push(syncErrors[key]); });
    return parts.join(" ");
  }
  function updateStatus() {
    var node = document.getElementById("sync");
    if (node) node.textContent = statusLine();
  }
  // Build one card; a failure becomes a visible error card instead of stopping the rest of the page.
  function guard(label, build) {
    try { return build(); }
    catch (error) {
      var message = label + ": " + ((error && error.message) || String(error));
      renderErrors.push(message);
      return el("div", { "class": "error", role: "alert", text: "This item could not be shown (" + message + ")." });
    }
  }

  // Quick reactions, a reply box and Send for one card, plus a button that opens the claude.ai comment composer on it.
  function reactionBox(kind, id, card) {
    var key = kind + ":" + id;
    var draft = drafts[key] || (drafts[key] = { reaction: "", text: "", id: "", sending: false, status: "" });
    var box = el("div", { "class": "reaction" });
    var latest = latestText(latestReaction(kind, id));
    if (latest) box.appendChild(el("p", { "class": "latest", text: latest }));
    var status = el("span", { "class": "status", "aria-live": "polite", text: draft.status });
    var choices = el("div", { "class": "choices" });
    REACTIONS.forEach(function (pair) {
      var button = el("button", { type: "button", "aria-pressed": String(draft.reaction === pair[0]), text: pair[1] });
      button.disabled = draft.sending || !db;
      button.addEventListener("click", function () {
        if (!db) return;
        draft.id = "";
        draft.reaction = draft.reaction === pair[0] ? "" : pair[0];
        composers[key].forEach(function (view) {
          Array.prototype.forEach.call(view.choices.children, function (other, index) {
            other.setAttribute("aria-pressed", String(draft.reaction === REACTIONS[index][0]));
          });
        });
      });
      choices.appendChild(button);
    });
    var input = el("input", { type: "text", maxlength: String(TEXT_LIMIT), placeholder: "Reply to Firstmate (optional)", "aria-label": "Reply to Firstmate", "data-draft": key });
    input.value = draft.text;
    input.disabled = draft.sending || !db;
    input.addEventListener("input", function () {
      draft.text = input.value;
      draft.id = "";
      composers[key].forEach(function (view) { if (view.input !== input) view.input.value = draft.text; });
    });
    var send = el("button", { type: "button", text: "Send" });
    send.disabled = draft.sending || !db;
    send.addEventListener("click", function () {
      if (!db) return;
      var text = draft.text.trim().replace(/\s+/g, " ");
      if (!draft.reaction && !text) {
        draft.status = "Pick a reaction or write a reply first.";
        composers[key].forEach(function (view) { view.status.textContent = draft.status; });
        return;
      }
      var id2 = draft.id || (draft.id = newReactionId());
      var data = { version: 1, id: id2, item_id: id, kind: kind, reaction: draft.reaction, text: text, at: new Date().toISOString(), source: "artifact" };
      draft.sending = true;
      draft.status = "Sending…";
      render();
      db.doc(INBOX + "/" + id2).set(data).then(function () {
        inboxDocs[id2] = data;
        delete drafts[key];
        render();
      }, function (error) {
        draft.sending = false;
        draft.status = "Could not send: " + ((error && error.message) || "unavailable");
        render();
      });
    });
    (composers[key] || (composers[key] = [])).push({ choices: choices, input: input, status: status });
    box.appendChild(choices);
    box.appendChild(el("div", { "class": "reply" }, [input, send, status]));
    var discuss = el("button", { type: "button", text: "Discuss with Firstmate" });
    discuss.disabled = !comments;
    discuss.addEventListener("click", function () {
      if (!comments) return;
      Promise.resolve().then(function () { return comments.openComposer({ element: card }); })
        .catch(function () { status.textContent = "Comments are unavailable in this view."; });
    });
    box.appendChild(el("div", { "class": "actions" }, [discuss]));
    var hint = accessHint();
    if (hint) box.appendChild(el("p", { "class": "note access", text: hint }));
    return box;
  }

  function currentAction(report) {
    var doc = actionDocs[report.id];
    return doc && doc.fingerprint === report.fingerprint && doc.at &&
      Date.parse(doc.at) > Date.parse(snapshot.generated_at) ? doc : null;
  }

  function currentActions() {
    return (snapshot.reports || []).map(currentAction).filter(Boolean);
  }

  // The state a report shows: the snapshot's, overlaid by an artifact action made after the export
  // for the same content. An action for changed content is ignored, as it is on import.
  function effectiveState(report) {
    var doc = currentAction(report);
    if (doc) {
      if (doc.state === "reviewed" || doc.state === "discarded" || doc.state === "needs review") return doc.state;
      if (doc.action === "mark") return "reviewed";
      if (doc.action === "discard") return "discarded";
      if (doc.action === "unmark" && report.state === "reviewed") return "needs review";
      if (doc.action === "undiscard" && report.state === "discarded") return "needs review";
    }
    return report.state;
  }

  function record(report, action, status) {
    if (!db) return;
    status.textContent = "Saving…";
    var before = effectiveState(report);
    var state = action === "mark" ? "reviewed" : action === "discard" ? "discarded" :
      (action === "unmark" && before === "reviewed" || action === "undiscard" && before === "discarded") ? "needs review" : before;
    var data = { report_id: report.id, action: action, state: state, fingerprint: report.fingerprint, at: new Date().toISOString() };
    db.doc(COLLECTION + "/" + docId(report.id)).set(data).then(function () {
      actionDocs[report.id] = data;
      render();
    }, function (error) {
      status.textContent = "Could not save: " + ((error && error.message) || "unavailable");
    });
  }

  function reportBody(report, section) {
    if (!report.markdown) return null;
    var id = "body-" + section + "-" + docId(report.id);
    var body = el("details", { id: id }, [
      el("summary", { text: "Read report" }),
      el("pre", { "class": "report-body", text: report.markdown }),
    ]);
    body.open = !!(pendingOpen && pendingOpen[id]);
    return body;
  }

  function reportCard(report, buttons) { return guard("report " + report.id, function () { return buildReportCard(report, buttons); }); }
  function buildReportCard(report, buttons) {
    var chips = [chip(report.home)];
    if (report.relevance === "stale") chips.push(chip("stale", "warn"));
    var card = el("article", { "class": "card" }, [
      el("h3", { text: report.title }),
      el("div", { "class": "chips" }, chips),
    ]);
    if (report.recommendation) card.appendChild(el("p", { text: "Recommendation: " + report.recommendation }));
    if (report.relevance === "stale" && report.relevance_reason) card.appendChild(el("p", { "class": "note", text: "Marked stale: " + report.relevance_reason }));
    card.appendChild(el("p", { "class": "note", text: report.id }));
    var body = reportBody(report, "reports");
    if (body) card.appendChild(body);
    if (report.ambiguous) {
      card.appendChild(el("p", { "class": "note", text: "ID is shared by multiple homes; actions are disabled." }));
    } else if (buttons.length) {
      var status = el("span", { "class": "status", "aria-live": "polite" });
      var row = el("div", { "class": "actions" });
      buttons.forEach(function (pair) {
        var button = el("button", { type: "button", text: pair[1] });
        button.disabled = !db;
        button.addEventListener("click", function () { button.disabled = true; record(report, pair[0], status); });
        row.appendChild(button);
      });
      row.appendChild(status);
      card.appendChild(row);
    }
    if (!report.ambiguous) card.appendChild(reactionBox("report", report.id, card));
    return card;
  }

  function callCard(call) { return guard("call " + call.id, function () { return buildCallCard(call); }); }
  function buildCallCard(call) {
    var chips = [chip(call.group, "group")];
    if (call.project) chips.push(chip(call.project));
    if (call.topic) chips.push(chip(call.topic));
    if (call.home) chips.push(chip(call.home));
    if (call.touched_at) chips.push(chip("touched " + ago(call.touched_at)));
    if (call.deferred) chips.push(chip(call.deferred, "warn"));
    if (call.sweep) chips.push(chip("keep, defer or drop?", "warn"));
    if (call.recommendation) chips.push(chip("Recommend: " + call.recommendation, "rec"));
    var card = el("article", { "class": "card" }, [el("h3", { text: call.title }), el("p", { text: call.ask }), el("div", { "class": "chips" }, chips)]);
    if (call.relevance === "stale" && call.relevance_reason) card.appendChild(el("p", { "class": "note", text: "Marked stale: " + call.relevance_reason }));
    if (typeof call.detail === "string" && call.detail.trim()) {
      var detailId = "detail-" + docId(call.band || "call") + "-" + docId(call.id);
      var detail = el("details", { id: detailId }, [
        el("summary", { text: "Details" }),
        el("div", { "class": "report-body", text: call.detail }),
      ]);
      detail.open = !!(pendingOpen && pendingOpen[detailId]);
      card.appendChild(detail);
    }
    var links = [];
    if (call.brief_url && safeUrl(call.brief_url)) links.push(el("a", { href: safeUrl(call.brief_url), target: "_blank", rel: "noopener", text: "Open brief" }));
    (call.links || []).forEach(function (link) {
      var href = safeUrl(link.url);
      if (href) links.push(el("a", { href: href, target: "_blank", rel: "noopener", text: link.label }));
    });
    if (links.length) {
      var row = el("p", { "class": "actions" });
      links.forEach(function (link) { row.appendChild(link); });
      card.appendChild(row);
    }
    card.appendChild(reactionBox("call", call.id, card));
    return card;
  }

  function group(id, title, note, count, nodes, emptyText, open) {
    var body = el("div", {}, nodes.length ? nodes : [el("p", { "class": "empty", text: emptyText })]);
    var details = el("details", { "class": "group", id: id }, [
      el("summary", {}, [el("h2", { text: title }), el("span", { "class": "count", text: String(count) })]),
      el("p", { "class": "note", text: note }),
      body,
    ]);
    if (open || pendingOpen && pendingOpen[id]) details.open = true;
    return details;
  }
  // `count` is the number of cards; `nodes` may also hold sub-headings, which are not items.
  function openSection(id, title, note, nodes, emptyText, count) {
    return el("section", { id: id }, [
      el("div", { "class": "head" }, [el("div", {}, [el("h2", { text: title }), el("p", { text: note })]), el("span", { "class": "count", text: String(count) })]),
      el("div", {}, nodes.length ? nodes : [el("p", { "class": "empty", text: emptyText })]),
    ]);
  }

  function render() {
    renderErrors = [];
    try {
      renderPage();
      renderFailure = "";
    } catch (error) {
      renderFailure = (error && error.message) || String(error);
      var root = document.getElementById("root");
      if (root) root.appendChild(el("div", { "class": "error", role: "alert", text: "The page could not be fully drawn (" + renderFailure + ")." }));
    }
    updateStatus();
  }

  function renderPage() {
    var root = document.getElementById("root");
    var openNow = {};
    Array.prototype.forEach.call(root.querySelectorAll("details"), function (d) { if (d.open) openNow[d.id] = true; });
    pendingOpen = openNow;
    var focused = document.activeElement && document.activeElement.getAttribute && document.activeElement.getAttribute("data-draft");
    root.textContent = "";
    composers = {};
    var calls = snapshot.calls || [];
    var reports = snapshot.reports || [];
    var byBand = function (band) { return calls.filter(function (call) { return call.band === band; }); };

    var session = snapshot.session;
    var desk = byBand("desk");
    var nodes = [];
    var lastHeading = null;
    desk.forEach(function (call) {
      if (call.desk_group && call.desk_group !== lastHeading) nodes.push(el("h3", { "class": "sub", text: call.desk_group }));
      lastHeading = call.desk_group;
      nodes.push(callCard(call));
    });
    var deskNote = session && session.idle ? "Open items from your last session. Everything else still open follows." :
      "What you raised or touched recently.";
    root.appendChild(openSection("desk", session && session.idle ? "Open items from our last session" : "On your desk", deskNote, nodes,
      "Nothing from this session is waiting on you. Earlier work is below.", desk.length));

    var related = (snapshot.related || []).map(function (item) { return guard("related " + item.id, function () { return relatedCard(item); }); }).filter(Boolean);
    function relatedCard(item) {
      var chips = (item.why || []).map(function (why) { return chip(why); });
      var base = item.kind === "report" ? reports.filter(function (r) { return r.id === item.id; })[0] : calls.filter(function (c) { return c.id === item.id; })[0];
      var card = el("article", { "class": "card" }, [
        el("p", { "class": "note", text: (item.kind === "report" ? "Report" : "Captain call") + " · " + item.home }),
        el("h3", { text: item.title }),
        el("div", { "class": "chips" }, chips),
      ]);
      if (item.kind === "report" && base && effectiveState(base) !== "needs review") return null;
      if (item.kind === "report" && base) {
        var body = reportBody(base, "related");
        if (body) card.appendChild(body);
      }
      if (item.kind === "report" && base && !base.ambiguous) {
        var status = el("span", { "class": "status", "aria-live": "polite" });
        var row = el("div", { "class": "actions" });
        [["mark", "Mark reviewed"], ["discard", "Discard"]].forEach(function (pair) {
          var button = el("button", { type: "button", text: pair[1] });
          button.disabled = !db;
          button.addEventListener("click", function () { button.disabled = true; record(base, pair[0], status); });
          row.appendChild(button);
        });
        row.appendChild(status);
        card.appendChild(row);
      }
      if (!(base && base.ambiguous)) card.appendChild(reactionBox(item.kind === "report" ? "report" : "call", item.id, card));
      return card;
    }

    var week = byBand("week").map(function (call) { return callCard(call); });
    root.appendChild(group("week", "This week", "Touched in the last 7 days.", week.length, week, "Nothing else was touched this week."));
    root.appendChild(group("related", "Related to this session", "Older reports and deferred or held calls that connect to what you are working on now, most related first. Not on your desk.",
      related.length, related, "Nothing older relates to what is on your desk or in flight right now."));
    var parked = byBand("parked").map(function (call) { return callCard(call); });
    root.appendChild(group("parked", "Parked", "Older, deferred, or never touched.", parked.length, parked, "Nothing is parked."));

    var states = reports.map(function (report) { return [report, effectiveState(report)]; });
    var waiting = states.filter(function (p) { return p[1] === "needs review" && p[0].relevance !== "stale"; }).map(function (p) {
      return reportCard(p[0], [["mark", "Mark reviewed"], ["discard", "Discard"]]);
    });
    root.appendChild(openSection("reports", "Reports waiting on your review", "Mark one reviewed once you have read it, or discard it to take it off the list without saying you reviewed it.", waiting,
      "No reports are waiting on your review.", waiting.length));
    var stale = states.filter(function (p) { return p[1] === "needs review" && p[0].relevance === "stale"; }).map(function (p) {
      return reportCard(p[0], [["mark", "Mark reviewed"], ["discard", "Discard"]]);
    });
    root.appendChild(group("stale-reports", "Stale reports", "One-offs or already decided; off the review list.", stale.length, stale, "No unreviewed report is marked stale."));
    var staleCalls = byBand("stale").map(function (call) { return callCard(call); });
    root.appendChild(group("stale-calls", "Calls marked stale", "One-offs or already decided; off your desk.", staleCalls.length, staleCalls, "No captain call is marked stale."));
    var reviewed = states.filter(function (p) { return p[1] === "reviewed"; }).map(function (p) { return reportCard(p[0], [["unmark", "Unmark"]]); });
    root.appendChild(group("reviewed", "Reviewed reports", "Unmark to return one to needs review.", reviewed.length, reviewed, "No reports are marked reviewed."));
    var discarded = states.filter(function (p) { return p[1] === "discarded"; }).map(function (p) { return reportCard(p[0], [["undiscard", "Undiscard"]]); });
    root.appendChild(group("discarded", "Discarded reports", "Off your list, not marked reviewed. Undiscard to bring one back.", discarded.length, discarded, "No reports are discarded."));

    var recorded = currentActions().length;
    var footer = el("footer", {}, [el("p", { text: "Actions you take here are saved in this artifact's own database and applied to the local state with `quarterdeck import`; reactions are delivered to Firstmate with `quarterdeck reactions import`. Current unreviewed report text travels in this private snapshot." })]);
    if (recorded) {
      var save = el("button", { type: "button", text: "Download " + recorded + " recorded action" + (recorded === 1 ? "" : "s") + " as JSON" });
      save.addEventListener("click", exportActions);
      footer.appendChild(save);
    }
    var pending = pendingReactions().length;
    if (pending) {
      var saveReactions = el("button", { type: "button", text: "Download " + pending + " recorded reaction" + (pending === 1 ? "" : "s") + " as JSON" });
      saveReactions.addEventListener("click", exportReactions);
      footer.appendChild(saveReactions);
    }
    root.appendChild(footer);
    if (focused) {
      var again = Array.prototype.filter.call(root.querySelectorAll("input[data-draft]"), function (node) { return node.getAttribute("data-draft") === focused; })[0];
      if (again) again.focus();
    }
  }

  function actionsJson() {
    var list = currentActions()
      .sort(function (a, b) { return Date.parse(a.at) - Date.parse(b.at); });
    return JSON.stringify({ version: 1, generated_at: snapshot.generated_at, actions: list }, null, 2) + "\n";
  }
  function reactionsJson() {
    return JSON.stringify({ version: 1, generated_at: snapshot.generated_at, reactions: pendingReactions() }, null, 2) + "\n";
  }
  function saveDownload(filename, data) {
    var failed = function () { syncErrors.downloads = "Downloads are unavailable in this view."; updateStatus(); };
    var runtime = window.claude;
    if (!runtime || typeof runtime.use !== "function") { failed(); return; }
    Promise.resolve().then(function () { return runtime.use("downloads"); }).then(function (downloads) {
      if (!downloads) { failed(); return; }
      return Promise.resolve(downloads.save({ filename: filename, data: data })).then(function () {
        delete syncErrors.downloads;
        updateStatus();
      });
    }).catch(failed);
  }
  function exportActions() { saveDownload("quarterdeck-actions.json", actionsJson()); }
  function exportReactions() { saveDownload("quarterdeck-reactions.json", reactionsJson()); }

  // Resolve a capability without ever throwing: a missing runtime, a rejection or a null all become "unavailable".
  function useCapability(name, label, fallbackReason) {
    var done = false;
    function settle(handle, reason) {
      if (done) return null;
      done = true;
      access[name] = handle ? { state: "ready", reason: "" } : { state: "unavailable", reason: reason };
      return handle || null;
    }
    return new Promise(function (resolve) {
      var runtime = window.claude;
      if (!runtime || typeof runtime.use !== "function") {
        resolve(settle(null, "open this page as a Claude artifact to use " + label + "."));
        return;
      }
      // The runtime resolves null after about 10 s; this only covers a runtime that never answers.
      var timer = setTimeout(function () {
        resolve(settle(null, label + " did not answer; reload the artifact."));
      }, 15000);
      function finish(handle, reason) { clearTimeout(timer); resolve(settle(handle, reason)); }
      var pending;
      try { pending = runtime.use(name); }
      catch (error) { finish(null, label + " failed to load (" + ((error && error.message) || "error") + ")."); return; }
      Promise.resolve(pending).then(function (handle) {
        finish(handle || null, fallbackReason);
      }, function (error) {
        finish(null, label + " failed to load (" + ((error && error.message) || "error") + ").");
      });
    });
  }

  function watch(name, handler, failure) {
    try {
      db.collection(name).onSnapshot(function (snap) {
        try { handler(snap); delete syncErrors[name]; } catch (error) { syncErrors[name] = failure; }
        render();
      }, function () { syncErrors[name] = failure; updateStatus(); });
    } catch (error) {
      syncErrors[name] = failure;
    }
  }

  document.getElementById("title").textContent = "⚓ " + (snapshot.title || "Quarterdeck");
  document.getElementById("generated").textContent = "Snapshot " + (snapshot.generated_at || "") + (snapshot.generated_at ? " (" + ago(snapshot.generated_at) + ")" : "");
  render();  // controls appear at once, disabled, and light up as each capability resolves

  useCapability("db", "the artifact database",
    "the artifact database is not available in this view (open the artifact signed in, not as a shared or top-level page, and check that it was published with the db capability).")
    .then(function (handle) {
      db = handle;
      if (handle) {
        watch(COLLECTION, function (snap) {
          actionDocs = {};
          snap.docs.forEach(function (doc) {
            var data = doc.data();
            if (data && typeof data.report_id === "string") actionDocs[data.report_id] = data;
          });
        }, "Could not read recorded actions.");
        watch(INBOX, function (snap) {
          inboxDocs = {};
          snap.docs.forEach(function (doc) {
            var data = doc.data();
            if (data && typeof data.id === "string" && typeof data.item_id === "string") inboxDocs[data.id] = data;
          });
        }, "Could not read recorded reactions.");
      }
      render();
    });
  useCapability("comments", "comments",
    "comments are not available in this view (the artifact needs the comments capability and a signed-in view).")
    .then(function (handle) { comments = handle; render(); });
})();
</script>
</body>
</html>
